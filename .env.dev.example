# Entorno de DESARROLLO (tu PC). Copia estas lineas al final de tu .env
# local; reemplazan a las de produccion. El .env del servidor NO las lleva.
# Detalle: README.md, seccion "Flujo de trabajo".

# Base de datos propia: los jobs que corras para probar no escriben en las
# tablas de produccion. Se crea una vez en MariaDB (ver README); las tablas
# de control de jobs se crean solas al arrancar, y las de datos al correr
# los loaders.
DB_NAME=informes_dev

# Todas las salidas de los jobs (Excel/CSV) van a esta carpeta, incluso las
# rutas guardadas desde /config. Las entradas (DBF, demanda, etc.) se siguen
# leyendo de las rutas reales, que es seguro porque solo se leen.
DEV_OUTPUT_DIR=\\172.10.18.2\Usuarios\Outputs_dev

# Sin jobs diarios de las 10:00 ni correos desde el PC.
SCHEDULER_ENABLED=false
SMTP_ENABLED=false

APP_ENV=local
DEBUG=true
