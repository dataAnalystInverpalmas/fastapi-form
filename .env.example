# Variables de entorno para el Portal de Datos Inverpalmas
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env real al repositorio.

# --- Base de datos MySQL/MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=
DB_NAME=informes

# --- Correo electrónico (SMTP) ---
# SMTP_ENABLED en false evita que la app intente enviar correos si el
# servidor todavia no esta configurado.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Portal de Datos Inverpalmas
SMTP_TIMEOUT=10

# --- Aplicación ---
APP_NAME=Portal de Datos Inverpalmas
APP_VERSION=1.0.0
DEBUG=false
APP_ENV=docker

# --- Montaje SMB/CIFS (Docker) ---
# Todas las rutas de la app apuntan al servidor por IP. SMB_SERVER debe ser
# ese mismo valor: la app traduce \\<SMB_SERVER>\<share>\... al montaje local.
SMB_SERVER=172.10.18.2
# Shares que se montan (uno por cada uno en SMB_MOUNT_ROOT/<share>). Lo leen
# entrypoint.sh y settings.SMB_SHARES; se acepta lista con comas o JSON.
SMB_SHARES=produc,Usuarios,newfact
# Share principal: el unico con punto de montaje propio (SMB_MOUNT_PATH).
SMB_SHARE=produc
SMB_MOUNT_ROOT=/mnt/smb
SMB_MOUNT_PATH=/mnt/smb/produc
SMB_USERNAME=
SMB_PASSWORD=
SMB_DOMAIN=
# nocase es necesario: las rutas mezclan mayusculas en las carpetas
# (produc/LD_BCULT y produc/ld_bcult), indistinto en Windows pero no en Linux.
# vers=2.1 es el dialecto maximo que habla el servidor (con vers=3.0 responde
# "Operation not supported"); subirlo si algun dia se actualiza el servidor.
# Sin sec=: el usuario/clave van por el archivo de credenciales, y sec=ntlm
# (NTLMv1) ya no lo acepta el kernel, falla con "Invalid argument".
SMB_OPTIONS=uid=1000,gid=1000,vers=2.1,iocharset=utf8,nocase

# --- Rutas DBF (rutas UNC del servidor) ---
DEFAULT_DBF_PATH=\\172.10.18.2\produc\LD_BCULT\hijos2026.dbf
LOAD_LD_BCULT_DIR=\\172.10.18.2\produc\ld_bcult
LOAD_HIJOS_PATH=\\172.10.18.2\produc\ld_bcult\hijos2026.dbf
LOAD_FUSARIUM_PATH=\\172.10.18.2\produc\basetdinamica\historico_fusarium.dbf

# --- Salida Excel ---
EXCEL_OUTPUT_DIR=\\172.10.18.2\Usuarios\Outputs
EXCEL_FILENAME=labores_de_siembra.xlsx

# --- ETL producto procesado ---
PPROCESADO_2024_PATH=\\172.10.18.2\produc\basetdinamica\pprocesado_2024.dbf
PPROCESADO_2025_PATH=\\172.10.18.2\produc\basetdinamica\pprocesado_2025.dbf
PPROCESADO_CURRENT_PATH=\\172.10.18.2\produc\basetdinamica\pprocesado.dbf
PPROCESADO_OUTPUT_PATH=\\172.10.18.2\produc\basetdinamica\pprocesado.csv

# --- ETL producción por picos ---
PRODUCCION_PICOS_OUTPUT_PATH=\\172.10.18.2\usuarios\Outputs\produccion_por_picos.csv

# --- ETL proyecciones ---
PROYECCIONES_BASE_DIR=\\172.10.18.2\produc\basetdinamica
PROYECCIONES_OUTPUT_PATH=\\172.10.18.2\produc\basetdinamica\proyecciones.csv

# --- ETL Quipus vs Proyecciones ---
QUIPUS_PLANO_PATH=//172.10.18.2/usuarios/Hilder/Data/tika-plano-siembra-todo.csv
QUIPUS_TIKA_DIR=//172.10.18.2/usuarios/Hilder/Data/tika/quipus
QUIPUS_OUTPUT_PATH=//172.10.18.2/usuarios/Hilder/Data/quipus.csv
QUIPUS_VS_PROY_OUTPUT_PATH=//172.10.18.2/usuarios/Hilder/Data/quipus_vs_proy.csv
# datos.xlsx: lo escribe quipus_vs_proy y lo lee planos_proyeccion_hoja1.
# Tiene que estar en un share (no en una carpeta local tipo C:\Users\...),
# o esos dos jobs fallan al correr dentro de Docker.
QUIPUS_EXCEL_OUTPUT_PATH=\\172.10.18.2\Usuarios\Hilder\Data\datos.xlsx
# Destinatarios del correo de cumplimiento_khipus_10_semanas.xlsx. Es una
# variable de tipo lista: debe ir en formato JSON (con corchetes y comillas),
# NUNCA separada por comas a secas ni vacia sin corchetes, o la app no
# arranca. Tambien se puede configurar desde Ajustes > Quipus.
QUIPUS_CUMPLIMIENTO_EMAILS=["produccion@inverpalmas.com","palermo@inverpalmas.com"]

# --- ETL comparar picos vs demanda ---
PICOS_DEMANDA_PATH=\\172.10.18.2\Usuarios\Hilder\Data\demanda_jun24-2526_abr24-2653_sep25-2752_v5.csv
PICOS_OUTPUT_PATH=\\172.10.18.2\produc\BASETDINAMICA\compara_pto_proy_real.csv
