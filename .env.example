# Variables de entorno para el Portal de Datos Inverpalmas
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env real al repositorio.

# --- Base de datos MySQL/MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=
DB_NAME=informes

# --- Correo electrónico (SMTP) ---
# SMTP_ENABLED en false evita que la app intente enviar correos si el
# servidor todavia no esta configurado.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Portal de Datos Inverpalmas
SMTP_TIMEOUT=10

# --- Aplicación ---
APP_NAME=Portal de Datos Inverpalmas
APP_VERSION=1.0.0
DEBUG=false
APP_ENV=docker

# --- Montaje SMB/CIFS (Docker) ---
SMB_SERVER=172.10.18.2
SMB_SHARE=produc
SMB_MOUNT_ROOT=/mnt/smb
SMB_MOUNT_PATH=/mnt/smb/produc
SMB_USERNAME=
SMB_PASSWORD=
SMB_DOMAIN=
SMB_OPTIONS=username=,uid=1000,gid=1000,vers=3.0,iocharset=utf8,sec=ntlm

# --- Rutas DBF (rutas UNC del servidor) ---
DEFAULT_DBF_PATH=\\svrinverpalmas\produc\LD_BCULT\hijos2026.dbf
LOAD_LD_BCULT_DIR=\\svrinverpalmas\produc\ld_bcult
LOAD_HIJOS_PATH=\\svrinverpalmas\produc\ld_bcult\hijos2026.dbf
LOAD_FUSARIUM_PATH=\\svrinverpalmas\produc\basetdinamica\historico_fusarium.dbf

# --- Salida Excel ---
EXCEL_OUTPUT_DIR=\\svrinverpalmas\Usuarios\Outputs
EXCEL_FILENAME=labores_de_siembra.xlsx

# --- ETL producto procesado ---
PPROCESADO_2024_PATH=\\svrinverpalmas\produc\basetdinamica\pprocesado_2024.dbf
PPROCESADO_2025_PATH=\\svrinverpalmas\produc\basetdinamica\pprocesado_2025.dbf
PPROCESADO_CURRENT_PATH=\\svrinverpalmas\produc\basetdinamica\pprocesado.dbf
PPROCESADO_OUTPUT_PATH=\\svrinverpalmas\produc\basetdinamica\pprocesado.csv

# --- ETL producción por picos ---
PRODUCCION_PICOS_OUTPUT_PATH=\\svrinverpalmas\usuarios\Outputs\produccion_por_picos.csv

# --- ETL proyecciones ---
PROYECCIONES_BASE_DIR=\\svrinverpalmas\produc\basetdinamica
PROYECCIONES_OUTPUT_PATH=\\svrinverpalmas\produc\basetdinamica\proyecciones.csv

# --- ETL Quipus vs Proyecciones ---
QUIPUS_PLANO_PATH=//svrinverpalmas/usuarios/Hilder/Data/tika-plano-siembra-todo.csv
QUIPUS_TIKA_DIR=//svrinverpalmas/usuarios/Hilder/Data/tika/quipus
QUIPUS_OUTPUT_PATH=//svrinverpalmas/usuarios/Hilder/Data/quipus.csv
QUIPUS_VS_PROY_OUTPUT_PATH=//svrinverpalmas/usuarios/Hilder/Data/quipus_vs_proy.csv
# Destinatarios del correo de cumplimiento_khipus_10_semanas.xlsx. Es una
# variable de tipo lista: debe ir en formato JSON (con corchetes y comillas),
# NUNCA separada por comas a secas ni vacia sin corchetes, o la app no
# arranca. Tambien se puede configurar desde Ajustes > Quipus.
QUIPUS_CUMPLIMIENTO_EMAILS=["produccion@inverpalmas.com","palermo@inverpalmas.com"]

# --- ETL comparar picos vs demanda ---
PICOS_DEMANDA_PATH=\\svrinverpalmas\Usuarios\Hilder\Data\demanda_jun24-2526_abr24-2653_sep25-2752_v5.csv
PICOS_OUTPUT_PATH=\\svrinverpalmas\produc\BASETDINAMICA\compara_pto_proy_real.csv
